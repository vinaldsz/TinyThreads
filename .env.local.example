# Example environment variables for TinyThreads (do NOT commit real secrets)
# Copy this file to .env.local and fill values for your local environment.

# AWS / S3
S3_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret

# MongoDB
MONGODB_URI=your-mongodb-connection-string
MONGODB_DB=MongoDB_Name

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Generate a secure secret (example): openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-base64-secret

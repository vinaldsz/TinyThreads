# Example environment variables for TinyThreads (do NOT commit real secrets)
# Copy this file to .env.local and fill values for your local environment.

# MongoDB
MONGODB_URI=your-mongodb-connection-string
MONGODB_DB=tinythreads

# AWS / S3
S3_BUCKET_NAME=your-s3-bucket-name
S3_PUBLIC_BASE=https://your-s3-bucket-name.s3.us-east-1.amazonaws.com
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret

# NextAuth (Google OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-base64-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@tinythreads.com
FOUNDERS_EMAIL=founders@tinythreads.com

# General
NODE_ENV=development
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
